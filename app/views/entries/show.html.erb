<% content_for :title, entry_page_title(@entry) %>
<% content_for :description, entry_excerpt(@entry, length: 155) %>

<section class="space-y-6">
  <%= link_to entries_path, class: "button-ghost" do %>
    <span aria-hidden="true">&lt;-</span>
    <span>Back to feed</span>
  <% end %>

  <article class="surface-panel article-panel" aria-labelledby="entry-title">
    <div class="space-y-6">
      <div class="space-y-3">
        <p class="section-label">Public entry</p>
        <h1 id="entry-title" class="section-title max-w-3xl"><%= entry_heading(@entry) %></h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">
          <span class="meta-chip"><%= entry_day_label(@entry) %></span>
          <time datetime="<%= @entry.created_at.iso8601 %>"><%= entry_timestamp(@entry) %></time>
        </div>
      </div>

      <div class="article-prose whitespace-pre-wrap"><%= @entry.body %></div>

      <% if (external_url = safe_external_url(@entry.link)) %>
        <div class="article-link-row">
          <span class="entry-footnote">Reference link</span>
          <%= link_to external_url, class: "entry-link", target: "_blank", rel: "noopener" do %>
            <span>Visit <%= entry_link_label(@entry.link) %></span>
            <span aria-hidden="true">-&gt;</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </article>
</section>
