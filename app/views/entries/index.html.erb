<% content_for :title, "buildlog" %>

<h1 class="text-3xl font-bold mb-8">buildlog</h1>

<% if @entries.empty? %>
  <p class="text-base-content/60">Nothing posted yet.</p>
<% else %>
  <div class="flex flex-col gap-4">
    <% @entries.each do |entry| %>
      <article class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <time datetime="<%= entry.created_at.iso8601 %>" class="text-sm text-base-content/60">
            <%= entry.created_at.strftime("%b %-d, %Y · %H:%M") %>
          </time>
          <p class="whitespace-pre-wrap"><%= entry.body %></p>
          <% if entry.link.present? %>
            <%= link_to entry.link, entry.link, class: "link link-primary text-sm break-all", target: "_blank", rel: "noopener" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
