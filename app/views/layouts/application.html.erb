<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Buildlog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Buildlog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/rss+xml" title="buildlog RSS feed" href="<%= feed_url %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200">
    <div class="navbar bg-base-100 shadow-sm px-5">
      <div class="flex-1">
        <%= link_to "buildlog", root_path, class: "btn btn-ghost text-xl" %>
      </div>
      <div class="flex-none gap-2">
        <div class="hidden sm:flex sm:items-center sm:gap-2">
          <%= render "layouts/social_links" %>
        </div>

        <div class="dropdown dropdown-end sm:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-sm" title="Links" aria-label="Links">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="1" />
              <circle cx="19" cy="12" r="1" />
              <circle cx="5" cy="12" r="1" />
            </svg>
          </div>
          <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 mt-3 w-40 p-2 shadow-sm gap-1">
            <%= render "layouts/social_links", li: true %>
          </ul>
        </div>

        <% if authenticated? %>
          <%= link_to "New entry", new_entry_path, class: "btn btn-primary btn-sm" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "btn btn-ghost btn-sm" %>
        <% end %>
      </div>
    </div>

    <main class="container mx-auto max-w-2xl px-5 py-10">
      <% if notice = flash[:notice] %>
        <div role="alert" class="alert alert-success mb-6"><span><%= notice %></span></div>
      <% end %>
      <% if alert = flash[:alert] %>
        <div role="alert" class="alert alert-error mb-6"><span><%= alert %></span></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
