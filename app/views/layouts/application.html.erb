<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Buildlog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Buildlog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/rss+xml" title="buildlog RSS feed" href="<%= feed_url %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200">
    <div class="navbar bg-base-100 shadow-sm px-5">
      <div class="flex-1">
        <%= link_to "buildlog", root_path, class: "btn btn-ghost text-xl" %>
      </div>
      <div class="flex-none gap-2">
        <%= link_to "https://ozzo.blog", class: "btn btn-ghost btn-sm", title: "ozzo.blog", target: "_blank", rel: "noopener" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
        <% end %>
        <%= link_to "https://github.com/ozzgio/buildlog", class: "btn btn-ghost btn-sm", title: "Source on GitHub", target: "_blank", rel: "noopener" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.94c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.17v3.22c0 .3.2.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
          </svg>
        <% end %>
        <%= link_to "https://x.com/ozzgio_", class: "btn btn-ghost btn-sm", title: "@ozzgio_ on X", target: "_blank", rel: "noopener" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.9L4.4 22H1.2l8.1-9.3L1 2h7l4.9 6.4L18.9 2zm-1.2 18h1.9L7.4 4h-2l12.3 16z" />
          </svg>
        <% end %>
        <%= link_to feed_url, class: "btn btn-ghost btn-sm", title: "RSS feed" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9" />
            <path d="M4 4a16 16 0 0 1 16 16" />
            <circle cx="5" cy="19" r="1" />
          </svg>
        <% end %>
        <% if authenticated? %>
          <%= link_to "New entry", new_entry_path, class: "btn btn-primary btn-sm" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "btn btn-ghost btn-sm" %>
        <% end %>
      </div>
    </div>

    <main class="container mx-auto max-w-2xl px-5 py-10">
      <% if notice = flash[:notice] %>
        <div role="alert" class="alert alert-success mb-6"><span><%= notice %></span></div>
      <% end %>
      <% if alert = flash[:alert] %>
        <div role="alert" class="alert alert-error mb-6"><span><%= alert %></span></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
