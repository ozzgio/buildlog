social_links = [
  { url: "https://ozzo.blog", title: "ozzo.blog", icon: ozzo_blog_icon },
  { url: "https://github.com/ozzgio/buildlog", title: "Source on GitHub", icon: github_icon },
  { url: "https://x.com/ozzgio_", title: "@ozzgio_ on X", icon: x_icon },
  { url: feed_url, title: "RSS feed", icon: rss_icon }
]
%>
<% social_links.each do |item| %>
  <% opens_new_tab = item[:url].to_s.start_with?("http") %>
  <% link = link_to(item[:icon], item[:url], class: "icon-button", title: item[:title], target: ("_blank" if opens_new_tab), rel: ("noopener" if opens_new_tab)) %>
  <% if local_assigns[:li] %>
    <li><%= link %></li>
  <% else %>
    <%= link %>
  <% end %>
<% end %>
