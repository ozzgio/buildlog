<% content_for :title, "Page not found - buildlog" %>
<% content_for :description, "The buildlog page you requested does not exist." %>

<section class="mx-auto max-w-4xl space-y-6 py-8 md:py-16">
  <p class="section-label">404 · Missing page</p>

  <div class="surface-panel space-y-6">
    <div class="space-y-3">
      <h1 class="section-title">That note is not here.</h1>
      <p class="hero-copy max-w-xl">
        This link may be old, or the address may have been copied incorrectly. The public feed is the best place to continue.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Read the latest notes", entries_path(anchor: "feed"), class: "button-primary" %>
      <%= link_to "Send feedback", feedback_path, class: "button-secondary" %>
    </div>
  </div>
</section>
