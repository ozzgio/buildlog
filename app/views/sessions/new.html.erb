<section class="auth-shell">
  <div class="surface-panel form-panel">
    <div class="space-y-3">
      <p class="section-label">Author access</p>
      <h1 class="section-title">Sign in</h1>
      <p class="panel-copy">Posting stays private even though the feed is public.</p>
    </div>

    <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
      <div class="space-y-2">
        <%= form.label :email_address, "Email address", class: "field-label" %>
        <%= form.email_field :email_address, required: true, maxlength: User::EMAIL_MAX_LENGTH, autofocus: true, autocomplete: "username", placeholder: "name@example.com", value: params[:email_address], class: "field-input" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password, "Password", class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Password", maxlength: User::PASSWORD_MAX_LENGTH, class: "field-input" %>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <%= form.submit "Sign in", class: "button-primary" %>
        <%= link_to "Forgot password?", new_password_path, class: "button-ghost" %>
      </div>
    <% end %>
  </div>

  <aside class="surface-panel side-panel">
    <p class="section-label">Why this gate exists</p>
    <div class="space-y-4 text-sm text-slate-600">
      <p>The point of buildlog is public progress, not public administration.</p>
      <p>Readers can browse everything without friction. Only the author needs credentials.</p>
    </div>
  </aside>
</section>
