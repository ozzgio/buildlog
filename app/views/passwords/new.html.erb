<section class="auth-shell">
  <div class="surface-panel form-panel">
    <div class="space-y-3">
      <p class="section-label">Recovery</p>
      <h1 class="section-title">Forgot your password?</h1>
      <p class="panel-copy">Enter the account email and buildlog will send reset instructions.</p>
    </div>

    <%= form_with url: passwords_path, class: "mt-8 space-y-5" do |form| %>
      <div class="space-y-2">
        <%= form.label :email_address, "Email address", class: "field-label" %>
        <%= form.email_field :email_address, required: true, maxlength: User::EMAIL_MAX_LENGTH, autofocus: true, autocomplete: "username", placeholder: "name@example.com", value: params[:email_address], class: "field-input" %>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Email reset instructions", class: "button-primary" %>
        <%= link_to "Back to sign in", new_session_path, class: "button-ghost" %>
      </div>
    <% end %>
  </div>

  <aside class="surface-panel side-panel">
    <p class="section-label">Reset flow</p>
    <div class="space-y-4 text-sm text-slate-600">
      <p>Password reset links are single-use and tied to the email on file.</p>
      <p>If nothing arrives, verify the address first, then check spam before retrying.</p>
    </div>
  </aside>
</section>
