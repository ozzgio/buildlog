<section class="auth-shell">
  <div class="surface-panel form-panel">
    <div class="space-y-3">
      <p class="section-label">Recovery</p>
      <h1 class="section-title">Update your password</h1>
      <p class="panel-copy">Choose a new password for the author account, then return to posting.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "mt-8 space-y-5" do |form| %>
      <div class="space-y-2">
        <%= form.label :password, "New password", class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: User::PASSWORD_MAX_LENGTH, class: "field-input" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: User::PASSWORD_MAX_LENGTH, class: "field-input" %>
      </div>

      <%= form.submit "Save password", class: "button-primary" %>
    <% end %>
  </div>

  <aside class="surface-panel side-panel">
    <p class="section-label">Password rule</p>
    <div class="space-y-4 text-sm text-slate-600">
      <p>Use a password you do not reuse elsewhere. This account controls publishing for the entire feed.</p>
    </div>
  </aside>
</section>
